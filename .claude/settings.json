{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "additionalDirectories": [
      ".claude/worktrees"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/no-main.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking the branch..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/spec-format.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking staged specs..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-verify.mjs\"",
            "timeout": 300,
            "statusMessage": "Running npm run verify before the push..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-merge-verify.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the PR's verify check..."
          }
        ]
      }
    ]
  }
}
