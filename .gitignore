node_modules
dist
# 0019. Next.js build output. `out/` is the static export the deploy workflow
# uploads and `.next/` is Turbopack's cache — both regenerated by every build,
# neither belongs in the tree. No trailing slash, matching the `dist` and
# `pipeline/raw` convention above so a symlink is ignored too.
out
.next
*.tsbuildinfo
.idea

# Claude Code: share skills, keep local settings and worktrees out
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/agents/
!.claude/settings.json
.claude/settings.local.json
*.local
.env*
.DS_Store

# API response cache (~80MB, regenerated by pipeline/run.py).
# No trailing slash: also ignores a symlink to a cache kept elsewhere,
# which a trailing slash would not match.
pipeline/raw
__pycache__/
