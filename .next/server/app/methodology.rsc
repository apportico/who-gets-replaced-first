tyle":{"marginTop":"10px"},"children":[["$","p",null,{"style":{"margin":"0"},"children":["$","span",null,{"className":"wz-badge","children":"DERIVED"}]}],["$","p",null,{"className":"wz-body","style":{"margin":"8px 0 0"},"children":"Arithmetic on official statistics. Nothing is added; the inputs and the operation are both stated."}]]}],["$","div",null,{"className":"wz-card","style":{"marginTop":"10px"},"children":[["$","p",null,{"style":{"margin":"0"},"children":["$","span",null,{"className":"wz-badge","children":"PROXY"}]}],["$","p",null,{"className":"wz-body","style":{"margin":"8px 0 0"},"children":"A stand-in for something no source measures globally. A proxy always says that it is one, and says what it is standing in for."}]]}],"$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12"]}],null,"$L13"]}],{},null,false,null]},null,false,"$14"]},null,false,null],"$L15",false]],"m":"$undefined","G":["$16",["$L17"]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"o8LgDYnyUEmOTWMLcUWHe"}
