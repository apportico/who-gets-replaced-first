{
  "name": "who-gets-replaced-first",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc -p pipeline/tsconfig.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "check:brand": "node scripts/check-schema-brand.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "node pipeline/run.ts",
    "pipeline:pilot": "node pipeline/run.ts --pilot",
    "test:pipeline": "node --test \"pipeline/tests/**/*.test.ts\"",
    "test:app": "node --test \"test/**/*.test.mjs\"",
    "test:hooks": "node --test \".claude/hooks/tests/*.test.mjs\"",
    "report": "node pipeline/report.ts",
    "verify": "bash scripts/verify.sh",
    "verify:data": "npm run pipeline:pilot",
    "start": "next start",
    "surface": "vitest run --config vitest.surface.config.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "next": "^16.3.4",
    "postcss": "^8.5.26",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
